# Öffentliche Frontend-Konfiguration
# Diese beiden Werte nach `.env.local` kopieren.

# Supabase Dashboard → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://DEINE_PROJECT_REF.supabase.co

# Supabase Dashboard → Project Settings → API → Publishable Key
# Falls noch kein Publishable Key angezeigt wird, den anon/public Key verwenden.
VITE_SUPABASE_ANON_KEY=

# WICHTIG:
# SUPABASE_SERVICE_ROLE_KEY gehört niemals in diese Frontend-Datei.
# SUPABASE_URL, SUPABASE_ANON_KEY und SUPABASE_SERVICE_ROLE_KEY werden
# von Supabase für gehostete Edge Functions automatisch bereitgestellt.
# APP_URL und ALLOWED_ORIGINS werden später separat als Function-Secrets gesetzt.

# Optionale öffentliche Native-Konfiguration (keine Credentials)
# Erst nach APNs-/Firebase-/Signing- und Backend-Einrichtung einschalten.
VITE_PUSH_ENABLED=false
VITE_PUSH_ENVIRONMENT=production
# Native Entwicklerbuilds für APNs verwenden development, Store-Builds production.
